# ─── AI Job Assistant — environment template ────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored; never commit it.
#
# NOTE: Do not wrap plain string values in quotes — pydantic-settings
# reads quote characters as part of the value. Only quote values that
# contain spaces or special characters.

# ─── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Adzuna (jobs API) ──────────────────────────────────────────
# Sign up: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=
ADZUNA_COUNTRY=au

# ─── Langfuse (LLMOps tracing) ──────────────────────────────────
# Self-hosted via docker-compose; defaults assume localhost.
# Get keys from the Langfuse UI after first login.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ─── Data paths ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_PATH=./data/vector_store
UPLOAD_DIR=./data/uploads

# ─── Chroma & Retrieval (Phase B) ────────────────────────────────
CHROMA_COLLECTION_NAME=resumes
EMBEDDING_BATCH_SIZE=100
TOP_K_RETRIEVAL=10
RERANKER_TOP_K=5
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# ─── App config ─────────────────────────────────────────────────
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
